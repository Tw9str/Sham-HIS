# Local fictional evaluation. For Vercel, follow docs/deployment.md.
SHAM_DEMO_MODE=true
# Hosted PostgreSQL takes precedence over the local SQLite path.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Required for a hosted demo; use a unique password of at least 12 characters.
# SHAM_DEMO_PASSWORD=
# Local only; defaults to data/sham.sqlite.
# SHAM_DB_PATH=C:/hospital-data/sham.sqlite
# Exact deployed HTTPS origin, without a trailing slash.
# SHAM_PUBLIC_ORIGIN=https://hospital.example
# First initialization of an EMPTY non-demo database requires 12+ characters.
# SHAM_ADMIN_PASSWORD=
