# LOCAL EVALUATION ONLY. Includes fictional records and known demo credentials.
SHAM_DEMO_MODE=true
# Optional absolute database path. Defaults to data/sham.sqlite.
# SHAM_DB_PATH=C:/hospital-data/sham.sqlite
# Set an exact public origin when implementing an HTTPS reverse proxy.
# SHAM_PUBLIC_ORIGIN=https://hospital.example
# For a separate EMPTY workspace, disable demo, choose a new database path,
# and provide a unique administrator password with at least 12 characters.
# SHAM_ADMIN_PASSWORD=your-unique-password
